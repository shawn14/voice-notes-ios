# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (for GPT + Whisper)
OPENAI_API_KEY=

# Operator fallback: allowed chat IDs (comma-separated)
# Paired users from the iOS app are automatically allowed
TELEGRAM_ALLOWED_CHAT_ID=

# Bot username without @ (for landing page CTA button)
TELEGRAM_BOT_USERNAME=heyeeon_bot

# Vercel KV (for pairing + inbox storage)
# These are auto-populated when you link Vercel KV in the dashboard
# For local dev, the in-memory store is used as fallback
KV_REST_API_URL=
KV_REST_API_TOKEN=
