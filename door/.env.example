# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (for GPT + Whisper)
OPENAI_API_KEY=

# Your Telegram chat ID (only this chat can use the bot)
# Find it by messaging the bot then checking:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_ID=

# Bot username without @ (for landing page CTA button)
# e.g., if your bot is @eeon_bot, set this to: eeon_bot
TELEGRAM_BOT_USERNAME=
